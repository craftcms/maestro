# These variables are only available to the Craft back-end!
# See frontend/.env to configure the front-end development server.

# Database connection settings
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=

# The control panel is served from the API domain
CRAFT_BASE_CP_URL=

# Domain Configuration
PRIMARY_SITE_URL=

# The name of the site and control panel
CRAFT_SITE_NAME=
